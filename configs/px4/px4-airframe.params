# PX4 airframe baseline — GENERIC QUAD X (example).
# Replace with your actual frame config from PX4 airframes, then overlay
# px4-c2.params for the transmitter-less C2 safety settings.
#
# This file intentionally contains only the C2-relevant airframe parameters.
# Full frame geometry/mixer values are generated by PX4's frame selection
# (SYS_AUTOSTART). Load px4-c2.params AFTER the frame config.

SYS_AUTOSTART = 4001        # PX4: Generic Quadcopter X
MAV_TYPE = 2                # MAV_TYPE_QUADROTOR

# Orientation (adjust to your build)
SENS_BOARD_ROT = 0
CAL_ACC0_ID = 0

# Motor geometry (example 450mm class quad X)
MPC_THR_HOVER = 0.5
MPC_MAN_TILT_MAX = 35.0
MPC_XY_VEL_MAX = 12.0
MPC_Z_VEL_MAX_UP = 3.0
MPC_Z_VEL_MAX_DN = 1.5

# Battery (example 6S Li-Ion/LiPo)
BAT1_N_CELLS = 6
BAT1_V_CHARGED = 4.2
BAT1_V_EMPTY = 3.3

# --- Apply the C2/safety overlay next ---
# mavparam set ...    (or load px4-c2.params in QGC)
