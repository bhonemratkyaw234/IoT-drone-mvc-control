# Normalize line endings. Linux configs and scripts MUST stay LF.
* text=auto

# Shell scripts and Linux-native configs: always LF
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.nmconnection text eol=lf
*.rules     text eol=lf
*.nft       text eol=lf
*.params    text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf

# Windows-only files (none currently) would go here:
# *.bat text eol=crlf

# Binary
*.png binary
*.jpg binary
*.pdf binary
